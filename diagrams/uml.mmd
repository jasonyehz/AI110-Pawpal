classDiagram
    class Owner {
        +String name
        +int available_minutes
        +List~Pet~ pets
        +add_pet(pet) void
        +get_all_tasks() List~Task~
    }

    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +add_task(task) void
    }

    class Task {
        +String title
        +int duration_minutes
        +String priority
        +bool completed
        +String pet_name
        +mark_complete() void
    }

    class ScheduledTask {
        +Task task
        +int start_minute
        +end_minute() int
    }

    class Plan {
        +List~ScheduledTask~ scheduled
        +List~Task, String~ skipped
    }

    class Scheduler {
        +Owner owner
        +Plan plan
        +generate_plan() Plan
        +explain_plan() String
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : plans for
    Scheduler --> Plan : produces
    Plan "1" *-- "0..*" ScheduledTask : contains
    ScheduledTask --> Task : wraps
    Plan ..> Task : skipped
