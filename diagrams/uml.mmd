classDiagram
    class Owner {
        +String name
        +int available_minutes
        +List~Pet~ pets
        +add_pet(pet) void
        +get_all_tasks() List~Task~
    }

    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +add_task(task) void
    }

    class Task {
        +String title
        +int duration_minutes
        +String priority
        +bool completed
        +mark_complete() void
    }

    class Scheduler {
        +Owner owner
        +generate_plan() List~Task~
        +explain_plan() String
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : plans for
    Scheduler ..> Task : orders
