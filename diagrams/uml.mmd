classDiagram
    class Owner {
        +String name
        +int available_minutes
        +List~Pet~ pets
        +add_pet(pet) void
        +get_all_tasks() List~Task~
    }

    class Pet {
        +String name
        +String species
        +List~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
    }

    class Task {
        +String description
        +int duration_minutes
        +String priority
        +String time
        +String frequency
        +bool completed
        +String pet_name
        +mark_complete() void
        +reset() void
    }

    class ScheduledTask {
        +Task task
        +int start_minute
        +end_minute() int
    }

    class Plan {
        +List~ScheduledTask~ scheduled
        +List~Task, String~ skipped
    }

    class Scheduler {
        +Owner owner
        +Plan plan
        +get_pending_tasks() List~Task~
        +get_tasks_for_pet(pet_name) List~Task~
        +sort_tasks(tasks) List~Task~
        +generate_plan() Plan
        +explain_plan() String
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : plans for
    Scheduler --> Plan : produces
    Plan "1" *-- "0..*" ScheduledTask : contains
    ScheduledTask --> Task : wraps
    Plan ..> Task : skipped
